    { "id": "press_inclinado_mancuernas", "nombre": "Press inclinado con mancuernas", "fedb_id": "Incline_Dumbbell_Press", "equipo": "mancuernas", "patron": "empuje_inclinado", "mecanica": "compuesto", "fatiga": "alta", "principal": "pecho", "secundarios": ["hombro_anterior", "triceps"], "tecnica": "Banco a 30°, no más, para que trabaje pecho y no solo hombro. Baja controlado hasta la parte alta del pecho." },
    { "id": "press_inclinado_smith", "nombre": "Press inclinado en Smith o máquina", "fedb_id": "Smith_Machine_Incline_Bench_Press", "equipo": "smith", "patron": "empuje_inclinado", "mecanica": "compuesto", "fatiga": "alta", "principal": "pecho", "secundarios": ["hombro_anterior", "triceps"], "tecnica": "Coloca el banco para que la barra baje a la parte alta del pecho, bajo la clavícula." },
